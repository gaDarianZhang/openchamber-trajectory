{
  "name": "openchamber-trajectory",
  "version": "0.1.10",
  "description": "Trajectory panel for OpenChamber, powered by an OpenCode collector plugin",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.0"
    },
    "contributes": {
      "panel": {
        "id": "trajectory",
        "name": "Trajectory",
        "icon": "route",
        "entry": "panel/index.html"
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "actions": [
        {
          "id": "open-trajectory",
          "label": "Open trajectory",
          "where": "session",
          "icon": "route"
        }
      ]
    }
  }
}
